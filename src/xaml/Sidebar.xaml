                                    <TextBlock Text="🏠 " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Performance" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Viewbox x:Name="SpinnerTabHome" Width="13" Height="13" HorizontalAlignment="Right" Margin="0,0,4,0"
                                         Style="{StaticResource SpinningIndicatorStyle}" Visibility="Collapsed"
                                         ToolTip="GPU-Drossel / Hintergrund-Dienst aktiv">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="#38BDF8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 8,2 A 6,6 0 1 1 2,8" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
