                                        <RadioButton x:Name="RadStressGpu" GroupName="StressTargetGroup" Content="Nur GPU" Style="{StaticResource FilterPillRadio}" Padding="10,5" Margin="0,0,10,0"/>

                                        <!-- DURATION BADGE -->
                                        <Border Background="#161A24" BorderBrush="#232B3C" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtStressDuration" Text="⏱ 00:00" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#94A3B8"/>
                                        </Border>

                                        <!-- START / STOP ACTION BUTTON -->
                                        <Button x:Name="BtnStressToggle" Style="{StaticResource SuccessBtn}" Height="34" Padding="16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtStressBtnIcon" Text="🔥 " FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtStressBtnLabel" Text="Stresstest starten" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- BOTTOM: LIVE METRICS & FEEDBACK STRIP -->
                                <Border Grid.Row="1" Background="#0B0E14" CornerRadius="8" BorderBrush="#1C212E" BorderThickness="1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Live-Status:" FontSize="11" Foreground="#64748B" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtStressLiveFeedback" Text="Hardware im Ruhezustand. Klicke auf 'Stresstest starten', um CPU und GPU maximal auszulasten." FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="⚠️ Kann jederzeit per Knopfdruck gestoppt werden" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

