            <Border x:Name="TabContentDrives" Grid.Row="2" Background="Transparent" Visibility="Collapsed">
                <ScrollViewer Style="{StaticResource TabScrollViewer}">
                    <StackPanel Style="{StaticResource TabContentStack}">
                        <!-- TAB HEADER -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Datenträger &amp; Laufwerke" Style="{StaticResource TabHeaderTitle}" Margin="0"/>
                                <TextBlock Text="Detaillierte Übersicht aller verbauten NVMe SSDs, SATA-Laufwerke, Partitionen &amp; Speicherbelegungen" Style="{StaticResource TabHeaderSubtitle}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnOpenDiskMgmt" Content="🗄️ Datenträgerverwaltung" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Height="34"/>
                                <Button x:Name="BtnOpenCleanMgr" Content="🧹 Bereinigung" Style="{StaticResource SecondaryBtn}" Height="34"/>
                            </StackPanel>
                        </Grid>

                        <!-- STORAGE & DISK DRIVES HERO CARD -->
                        <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Border Style="{StaticResource IconBoxBorder}">
                                            <TextBlock Style="{StaticResource IconBoxText}" Text="&#xEDA2;"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SPEICHERMEDIEN (NVMe / SSD / HDD)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="Verbaute physische Datenträger &amp; Partitionen" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource StatusPillBorder}" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtStorageSummary" Text="Ermittle..." FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource SeparatorLine}" Margin="0,2,0,14"/>

                                <StackPanel x:Name="StackDrivesList">
                                    <TextBlock Text="Lade Datenträger-Informationen..." Foreground="#94A3B8" FontSize="11.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
