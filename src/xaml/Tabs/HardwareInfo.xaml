                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Style="{StaticResource StatusPillBorder}" Padding="7,2" Margin="0,0,6,0">
