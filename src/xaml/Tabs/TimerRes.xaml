                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Top 2:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="TxtBenchTop2Res" Text="0.5100 ms" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button x:Name="BtnApplyTop2" Content="Setzen" Style="{StaticResource SecondaryBtn}" Height="22" FontSize="10" FontWeight="SemiBold" Padding="8,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- TOP 3 -->
                                            <Border x:Name="BorderBenchTop3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Top 3:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="TxtBenchTop3Res" Text="0.5200 ms" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button x:Name="BtnApplyTop3" Content="Setzen" Style="{StaticResource SecondaryBtn}" Height="22" FontSize="10" FontWeight="SemiBold" Padding="8,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- RESULTS LOG TABLE -->
                                <Border Background="#080A0F" CornerRadius="8" BorderBrush="#1A1F2C" BorderThickness="1.2" Padding="10,8" Height="140">
                                    <ScrollViewer x:Name="ScrollBenchResults" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBox x:Name="TxtBenchResultsLog" 
                                                 Background="Transparent" 
                                                 Foreground="#F1F5F9" 
                                                 BorderThickness="0" 
                                                 FontFamily="Consolas, Courier New, monospace" 
                                                 FontSize="10.5" 
                                                 IsReadOnly="True" 
                                                 TextWrapping="NoWrap" 
                                                 IsUndoEnabled="False"
                                                 AcceptsReturn="True"
                                                 Text="Benchmark-Protokoll: Klicke auf '🚀 Benchmark starten', um den Sweet-Spot zu ermitteln."/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
